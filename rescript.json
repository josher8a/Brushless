{
    "name": "brushless",
    "namespace": true,
    "sources": {
      "dir": "src",
      "subdirs": true
    },
    "gentypeconfig": {
      "language": "typescript",
      "generatedFileExtension": ".bs.ts",
      "module": "esmodule",
      "debug": {
        "all": false,
        "basic": false
      }
  },
    "package-specs": {
      "module": "esmodule",
      "in-source": true
    },
    "suffix": ".bs.js",
    "warnings": {
        "number": "+A"
      }
  }