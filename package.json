{
  "name": "brushless",
  "version": "0.3.0",
  "description": "DynamoDB utils lib write in Rescript and Typescript",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src/Brushless.res",
    "src/Brushless.bs.js",
    "src/Brushless.bs.ts",
    "src/external.ts",
    "rescript.json"
  ],
  "keywords": [
    "AWS",
    "Dynamodb",
    "expressions",
    "Rescript",
    "Typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josher8a/brushless.git"
  },
  "bugs": {
    "url": "https://github.com/josher8a/brushless/issues"
  },
  "homepage": "https://github.com/josher8a/brushless",
  "scripts": {
    "build": "rescript && npm run gentype:patch && npm run gentype:check && tsup",
    "res:build": "rescript && npm run gentype:patch",
    "res:clean": "rescript clean",
    "res:dev": "rescript watch",
    "res:format": "rescript format -all",
    "gentype:patch": "node scripts/patch-gentype.mjs",
    "gentype:check": "tsc --noEmit --strict --skipLibCheck src/Brushless.bs.ts src/Condition.typecheck.ts src/Update.typecheck.ts",
    "test": "bun test \"src/\""
  },
  "author": {
    "name": "Joshua Hernandez",
    "email": "josher8a@gmail.com"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "rescript": ">=12.2.0"
  },
  "peerDependenciesMeta": {
    "rescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.693.0",
    "@aws-sdk/util-dynamodb": "^3.693.0",
    "@types/bun": "^1.1.13",
    "@types/node": "^18.11.9",
    "bun": "^1.1.34",
    "rescript": "^12.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}